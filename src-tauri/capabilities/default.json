{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ValuePlus System main window capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/Desktop/รายงานใบจัดรายวัน"
        },
        {
          "path": "$HOME/Desktop/รายงานใบจัดรายวัน/**/*"
        }
      ]
    },
    "process:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://script.google.com/**"
        },
        {
          "url": "https://script.googleusercontent.com/**"
        }
      ]
    }
  ]
}