{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ValuePlus System main window capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://script.google.com/**"
        },
        {
          "url": "https://script.googleusercontent.com/**"
        }
      ]
    }
  ]
}