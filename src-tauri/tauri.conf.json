{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "ValuePlus System",
    "version":  "1.0.9",
    "identifier":  "com.valueplus.system",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "ValuePlus System",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  1100,
                                    "minHeight":  700,
                                    "center":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "externalBin":  [
                                       "binaries/valueplus-engine"
                                   ],
                   "resources":  [
                                     "resources/templates/*.xlsx"
                                 ],
                   "targets":  [
                                   "nsis"
                               ],
                   "createUpdaterArtifacts":  true,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installerIcon":  "icons/icon.ico",
                                                "uninstallerIcon":  "icons/icon.ico",
                                                "installerHooks":  "windows/installer-hooks.nsh"
                                            }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMjRFMzA2OTFFM0RFRTkKUldUcDN1T1JCdU1rc0VhTkt0TnYrS2V0aVZZTDJ2ZVhOanJRL293bitGMDd6NWlqbGdhc1BzZW8K",
                                    "endpoints":  [
                                                      "https://github.com/Geniussalt001/valueplus-system-releases/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}
